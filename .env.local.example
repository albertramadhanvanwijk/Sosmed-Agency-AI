# Salin berkas ini menjadi .env.local lalu isi nilainya.
# Berkas .env.local sudah tercantum di .gitignore sehingga tidak ikut ter-commit.

# --- Wajib -----------------------------------------------------------------
# Kunci akses 9Router. Salin dari aplikasi 9Router, menu API Keys.
NINE_ROUTER_API_KEY=isi-kunci-anda-di-sini

# Alamat dasar API 9Router yang berjalan di komputer ini.
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1

# --- Opsional --------------------------------------------------------------
# Folder keluaran hasil produksi. Default: ./output
# OUTPUT_DIR=./output

# Port antarmuka Studio. Default: 4321
# STUDIO_PORT=4321

# Jalur Chromium manual. Hanya perlu diisi bila pencarian otomatis gagal.
# Urutan pencarian otomatis: variabel ini, cache Playwright, Chrome, lalu Edge.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=C:\path\ke\chrome.exe
